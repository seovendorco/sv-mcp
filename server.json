{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "co.seovendor/sv-mcp",
  "title": "SV MCP",
  "description": "SEO and GEO tools from the SV API: keyword research, page audits, AI-visibility audits, content.",
  "websiteUrl": "https://seovendor.co/api/mcp",
  "repository": {
    "url": "https://github.com/seovendorco/sv-mcp",
    "source": "github"
  },
  "version": "0.2.0",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.seovendor.co"
    }
  ],
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "sv-mcp",
      "version": "0.2.0",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "SV_API_KEY",
          "description": "Your SV API key (free at https://access.seovendor.co/signup)",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
